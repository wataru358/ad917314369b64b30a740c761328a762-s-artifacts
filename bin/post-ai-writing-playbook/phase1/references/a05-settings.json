{
  "version": "dev-writing-voice-v1",
  "scope": "A05; full fixed English cohort 38980; P only; no exclusions",
  "baseline_years": [2018, 2019, 2020, 2021],
  "comparison_years": [2023, 2024],
  "transition_year": 2022,
  "partial_year": 2025,
  "same_month_auxiliary": [1, 2, 3, 4, 5, 6, 7, 8, 9],
  "word_groups": {
    "first_singular": ["i", "me", "my", "mine", "myself", "i'm", "i'll", "i've", "i'd"],
    "first_plural": ["we", "us", "our", "ours", "ourselves", "we're", "we'll", "we've", "we'd"],
    "second_person": ["you", "your", "yours", "yourself", "yourselves", "you're", "you'll", "you've", "you'd"],
    "lets": ["let's"],
    "contractions": [
      "ain't",
      "aren't",
      "can't",
      "couldn't",
      "daren't",
      "didn't",
      "doesn't",
      "don't",
      "hadn't",
      "hasn't",
      "haven't",
      "he'd",
      "he'll",
      "he's",
      "here's",
      "how's",
      "i'd",
      "i'll",
      "i'm",
      "i've",
      "isn't",
      "it'd",
      "it'll",
      "it's",
      "let's",
      "mightn't",
      "mustn't",
      "needn't",
      "oughtn't",
      "shan't",
      "she'd",
      "she'll",
      "she's",
      "shouldn't",
      "that'd",
      "that'll",
      "that's",
      "there'd",
      "there'll",
      "there's",
      "they'd",
      "they'll",
      "they're",
      "they've",
      "wasn't",
      "we'd",
      "we'll",
      "we're",
      "we've",
      "weren't",
      "what'd",
      "what'll",
      "what's",
      "when's",
      "where's",
      "who'd",
      "who'll",
      "who's",
      "who've",
      "why's",
      "won't",
      "wouldn't",
      "you'd",
      "you'll",
      "you're",
      "you've"
    ],
    "hedge_modals": ["may", "might", "could"],
    "obligation_modals": ["must", "should"],
    "modal_may": ["may"],
    "modal_might": ["might"],
    "modal_could": ["could"],
    "modal_must": ["must"],
    "modal_should": ["should"],
    "modal_can": ["can"],
    "modal_will": ["will"],
    "modal_would": ["would"],
    "modal_shall": ["shall"]
  },
  "phrase_groups": {
    "in_this_article": ["in this article"],
    "in_this_tutorial": ["in this tutorial"],
    "in_conclusion": ["in conclusion"],
    "important_to_note": ["it's important to note", "it is important to note"],
    "however": ["however"],
    "moreover": ["moreover"],
    "ultimately": ["ultimately"]
  },
  "paragraph_initial_connectors": [
    "however",
    "moreover",
    "ultimately",
    "furthermore",
    "therefore",
    "nevertheless",
    "additionally",
    "finally",
    "meanwhile",
    "instead",
    "also"
  ],
  "punctuation": {
    "question_mark": "?",
    "exclamation_mark": "!",
    "em_dash": "—",
    "en_dash": "–",
    "double_hyphen": "--",
    "single_hyphen": "-",
    "open_parenthesis": "(",
    "close_parenthesis": ")",
    "colon": ":"
  },
  "focal_exploratory_groups": [
    "first_singular",
    "first_plural",
    "second_person",
    "lets",
    "contractions",
    "hedge_modals"
  ],
  "bootstrap": {
    "replicates": 2000,
    "seed": 42,
    "min_authors_per_main_year": 30,
    "min_valid_replicates": 1900,
    "coverage_threshold": 0.9,
    "interval": "percentile 95%, linear; known single author IDs sampled across all 8 years; conditional and non-simultaneous",
    "p_values": "not_run"
  },
  "audit": {
    "roles": ["first_singular", "first_plural", "second_person", "contractions", "ambiguous_us"],
    "selection": "one article per available year and role, minimum SHA256(42:A05:role:article_id); first matching owner; first hit +/-180 characters; role duplicates retained",
    "blind": false
  },
  "readability": "skipped before results; no pinned validated technical syllable counter; sentence length already A02; no independent evidence claim",
  "counterfactual_or_AI_inference": false
}
