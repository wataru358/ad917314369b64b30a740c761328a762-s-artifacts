# Download original reports/workbooks from the cited official sources locally.
# Keep third-party report content, Office metadata, and macros out of Git.
/bin/analytics/japan-travel-weather/data/accommodation/*.xlsx
/bin/analytics/japan-travel-weather/data/tourism/hokkaido/*.xlsx
/bin/analytics/japan-travel-weather/data/tourism/hokkaido/*.xlsm
/bin/analytics/japan-travel-weather/data/tourism/hokkaido/*.pdf
/bin/analytics/japan-travel-weather/data/tourism/kyoto/*.pdf

